# Copy to .env. Nothing in this file is a secret; keys and certificates live in ./certs and
# ./secrets, which are gitignored.

# --- relay ---
# letsencrypt: the relay gets a certificate for RELAY_HOSTNAME itself. Ports 80 and 443 must
# reach the container (set RELAY_HTTP_PORT=80 and RELAY_HTTPS_PORT=443).
RELAY_CERT_MODE=letsencrypt
RELAY_HOSTNAME=relay.example.org
RELAY_CONTACT=you@example.org
# manual: put relay.crt and relay.key in ./certs and set RELAY_CERT_MODE=manual.
# proxy: Caddy in front of the relay and the gateway, set by docker-compose.proxy.yml. Uncomment the
# block below instead of choosing a mode here; RELAY_HOSTNAME is still read, RELAY_CONTACT is not.
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
# PUSH_HOSTNAME=push.example.org
# SITE_HOSTNAME=example.org
RELAY_HTTP_PORT=80
RELAY_HTTPS_PORT=443
RELAY_QUIC_PORT=7842
# false uses Let's Encrypt's staging server while you are trying things out.
RELAY_LETSENCRYPT_PROD=true
# Set to error only while debugging a startup problem; the relay logs peer addresses (see README).
# RELAY_LOG=error

# --- push gateway (ours; only the owner of the app's APNs and FCM keys can run a useful one) ---
# Paths are inside the container; ./secrets is mounted at /secrets.
# APNS_KEY_PATH=/secrets/AuthKey.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_SANDBOX=0
# FCM_SERVICE_ACCOUNT_PATH=/secrets/fcm-service-account.json
PUSH_RATE_LIMIT_PER_MINUTE=30
