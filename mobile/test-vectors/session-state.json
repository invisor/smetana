{
  "note": "Journal event sequences and the session state after each event. Checked by session::model::state_of (src-tauri) and by mobile/src/bridge/sessionState.js, so the two folds cannot drift apart. Events carry the wire `kind` and, where the fold reads it, `id`. `alive: false` models a dead child: Rust passes child_alive=false, the phone is told the ended state by a snapshot, so only `final` is compared.",
  "sequences": [
    { "name": "empty journal", "events": [], "after": [], "initial": "starting" },
    {
      "name": "turn opens and closes with a result",
      "events": [{ "kind": "turn-start" }, { "kind": "result" }],
      "after": ["running", "ready"]
    },
    {
      "name": "turn closed by a failure is ready while the child lives",
      "events": [{ "kind": "turn-start" }, { "kind": "turn-failed" }],
      "after": ["running", "ready"]
    },
    {
      "name": "permission asks, answer returns to running",
      "events": [
        { "kind": "turn-start" },
        { "kind": "permission", "id": "p1" },
        { "kind": "permission-answered", "id": "p1" },
        { "kind": "result" }
      ],
      "after": ["running", "needs-you", "running", "ready"]
    },
    {
      "name": "two permissions answered out of order",
      "events": [
        { "kind": "turn-start" },
        { "kind": "permission", "id": "a" },
        { "kind": "permission", "id": "b" },
        { "kind": "permission-answered", "id": "b" },
        { "kind": "permission-answered", "id": "a" }
      ],
      "after": ["running", "needs-you", "needs-you", "needs-you", "running"]
    },
    {
      "name": "answer for an unknown id changes nothing",
      "events": [
        { "kind": "turn-start" },
        { "kind": "permission", "id": "a" },
        { "kind": "permission-answered", "id": "zzz" }
      ],
      "after": ["running", "needs-you", "needs-you"]
    },
    {
      "name": "permission outranks a closed turn",
      "events": [
        { "kind": "turn-start" },
        { "kind": "permission", "id": "a" },
        { "kind": "result" }
      ],
      "after": ["running", "needs-you", "needs-you"]
    },
    {
      "name": "text question waits for the next turn",
      "events": [
        { "kind": "turn-start" },
        { "kind": "text" },
        { "kind": "text-question" },
        { "kind": "result" },
        { "kind": "turn-start" },
        { "kind": "result" }
      ],
      "after": ["running", "running", "needs-you", "needs-you", "running", "ready"]
    },
    {
      "name": "text question with no turn at all",
      "events": [{ "kind": "text-question" }],
      "after": ["needs-you"]
    },
    {
      "name": "kinds the fold ignores still make the session ready",
      "events": [
        { "kind": "opening" },
        { "kind": "user-message" },
        { "kind": "text-delta" },
        { "kind": "reasoning" },
        { "kind": "tool-use" },
        { "kind": "tool-result" },
        { "kind": "error" }
      ],
      "after": ["ready", "ready", "ready", "ready", "ready", "ready", "ready"]
    },
    {
      "name": "dead child with a closed turn is exited",
      "events": [{ "kind": "turn-start" }, { "kind": "result" }],
      "alive": false,
      "final": "exited"
    },
    {
      "name": "dead child with an open turn is failed",
      "events": [{ "kind": "turn-start" }],
      "alive": false,
      "final": "failed"
    }
  ]
}
