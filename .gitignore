node_modules/
dist/
.playwright-mcp/
.DS_Store
*.local

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
# The contents rather than the directory itself: git cannot re-include anything
# under an excluded parent, and `.claude/rules/` has to be tracked. It is the
# other half of CLAUDE.md, for the reason that document's own preamble gives —
# one kept out of every worktree cut for a task is one nothing working in a
# worktree can correct when the code moves underneath it.
.claude/*
!.claude/rules/
docs
.beads
.smetana

# Tauri
src-tauri/target/
src-tauri/gen/
src-tauri/binaries/*
!src-tauri/binaries/LICENSE-bd

# Worktrees cut for tracker tasks
.worktrees/
